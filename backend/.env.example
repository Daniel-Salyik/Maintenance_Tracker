API_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/bike_tracker_dev
# Used when NODE_ENV=test (npm run dev:test). Database name must end in _test.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/bike_tracker_test
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Local dev uses Mailpit (docker compose up -d mailpit): SMTP :1025, inbox http://localhost:8025.
# For a real provider, change these only; auth is used when both USER and PASS are set.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Maintenance Tracker <no-reply@localhost>"
